APP_NAME="Do And Gain"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dag.example.com
# DAG_PUBLIC_URL=https://dag.eclud.com.br
INERTIA_DEVTOOLS_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=dag
DB_USERNAME=dag
DB_PASSWORD=
# compose.easypanel.yaml usa easypanel-promovilas-prod por padrão.
# DAG_POSTGRES_NETWORK=easypanel-outro-projeto
# Se o provedor fornecer uma URI com TLS, preencha DB_URL com a URI completa.
# DB_URL=postgresql://usuario:senha@host:5432/dag?sslmode=require

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
LOG_CHANNEL=stderr

DAG_PHONE_KEY=
DAG_OTP_KEY=
DAG_PUSH_SUBJECT=
DAG_PUSH_PUBLIC_KEY=
DAG_PUSH_PRIVATE_KEY=
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
WHATSAPP_SENDER_NUMBER=
